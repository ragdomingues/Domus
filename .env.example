# --- O que TENS de preencher (copia para .env na raiz) ---
#
# Docker (API + Postgres + EMQX):
#   cd docker && docker compose --env-file ../.env up -d --build
# O ficheiro `.env` na raiz é a fonte única (igual ao TopInvest).

POSTGRES_DB=domus
POSTGRES_USER=domus
POSTGRES_PASSWORD=domus_dev_password
POSTGRES_PORT=5432

EMQX_MQTT_PORT=1883
EMQX_MQTT_TLS_PORT=8883
EMQX_DASHBOARD_PORT=18083
EMQX_DASHBOARD_USER=admin
EMQX_DASHBOARD_PASSWORD=public

API_PORT=8080

JWT_ISSUER=domus
JWT_AUDIENCE=domus-app
JWT_SIGNING_KEY=gere_uma_string_longa_e_aleatoria_min_32_chars

MQTT_API_USERNAME=domus_api
MQTT_API_PASSWORD=domus_api_dev_password
MQTT_HOOK_SECRET=domus_mqtt_hook_dev_secret

# Recuperação de senha (obrigatório para envio de e-mail) — mesmo contrato TopInvest
# APP_PUBLIC_URL=https://app.domus.local
# SMTP_HOST=smtp.seuprovedor.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASS=            # se tiver $ na senha, no Docker use $$ (ex.: senha$$123)
# MAIL_FROM="Domus <noreply@seudominio.com>"
# Em Development, se true, o token também vem no JSON (útil sem SMTP).
# AUTH_EXPOSE_RESET_TOKEN=true

# Histórico (comandos + eventos) — limpeza automática
# HISTORY_RETENTION_DAYS=90
# HISTORY_RETENTION_INTERVAL_HOURS=24

# Push Expo (produção / lojas)
# 1) Firebase: google-services.json em src/mobile/ (package app.domus.mobile)
# 2) EAS: eas credentials → Android → FCM V1 (service account JSON)
# 3) EAS: eas credentials → iOS → Push Key (APNs)
# 4) Se "Enhanced Security" estiver ativo no Expo, preencha o access token:
# EXPO_ACCESS_TOKEN=
# EXPO_PUSH_API_URL=https://exp.host/--/api/v2/push/send
