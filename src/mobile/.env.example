# Copie para .env / .env.homolog / .env.production conforme o script npm.
EXPO_PUBLIC_APP_ENV=dev

# Em dev, use "auto" para funcionar em celular e emulador ao mesmo tempo:
# - celular físico → IP da máquina na LAN (detectado pelo Expo/Metro)
# - emulador Android → 10.0.2.2
EXPO_PUBLIC_API_BASE_URL=http://auto:8080
EXPO_PUBLIC_SIGNALR_HUB_URL=http://auto:8080/hubs/devices
