#pragma once

// Copie para include/secrets.h (não versionar secrets.h com credenciais reais).
// Em campo: deixe WIFI_SSID vazio e use o SoftAP "Domus-Setup-XXXX" no 1º boot,
// ou segure o botão BOOT ~3s para reabrir o portal.

#define WIFI_SSID "sua-rede"
#define WIFI_PASSWORD "sua-senha"

// API Domus (activate). Em LAN use IP do host; não use localhost no ESP32.
#define DOMUS_API_BASE_URL "http://192.168.1.10:8080"

// Broker EMQX
#define MQTT_HOST "192.168.1.10"
#define MQTT_PORT 1883

// Código one-time emitido pelo admin (POST provisioning). Usado só se NVS vazio.
// Também pode ser digitado no portal SoftAP.
#define PROVISIONING_CODE "COLE-O-CODIGO-AQUI"

